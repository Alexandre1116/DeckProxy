{
  "UUID": "pt.cli-proxy.monitor",
  "Name": "DeckProxy",
  "Description": "Monitor CLIProxyAPI requests and remaining quota.",
  "Author": "Alexandre1116",
  "Version": "3.5.0.0",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "7.6"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "13"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Nodejs": {
    "Version": "24"
  },
  "CodePath": "plugin.js",
  "Icon": "img/plugin",
  "Category": "DeckProxy",
  "CategoryIcon": "img/action",
  "Actions": [
    {
      "UUID": "pt.cli-proxy.monitor.metric",
      "Name": "Metric (legacy)",
      "Tooltip": "Configure an existing metric.",
      "Icon": "img/action",
      "PropertyInspectorPath": "settings.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "img/key",
          "TitleAlignment": "middle",
          "FontSize": 13
        }
      ],
